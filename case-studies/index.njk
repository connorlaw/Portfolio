---
layout: base
pageTitle: Case Studies
metaDescription: Explore my UK-based web design and development case studies, where I showcase my passion for creating stunning user interfaces and delivering seamless web experiences.
---

<section class="section section--center">
  <div class="section__inner">
    <p class="section__inner--subtitle">Case studies</p>
    <h1 class="section__inner--title">Check out my<br />latest projects</h1>
    <br/>

    <div class="search--wrapper">
      <input class="search" inputmode="search" type="text" id="search" placeholder="Search case studies..." />
      <span class="search--clear"></span>
    </div>

    <div class="section__inner--flex" style="margin-top:16px;">
      <div class="case-study-tiles-view-toggle">
        <label>
          <input type="radio" name="view" value="grid" checked>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-grid-3x2" viewBox="0 0 16 16">
            <path d="M0 3.5A1.5 1.5 0 0 1 1.5 2h13A1.5 1.5 0 0 1 16 3.5v8a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 0 11.5v-8zM1.5 3a.5.5 0 0 0-.5.5V7h4V3H1.5zM5 8H1v3.5a.5.5 0 0 0 .5.5H5V8zm1 0v4h4V8H6zm4-1V3H6v4h4zm1 1v4h3.5a.5.5 0 0 0 .5-.5V8h-4zm0-1h4V3.5a.5.5 0 0 0-.5-.5H11v4z"/>
          </svg>
        </label>
        <label>
          <input type="radio" name="view" value="list">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-card-list" viewBox="0 0 16 16">
            <path d="M14.5 3a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h13zm-13-1A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2h-13z"/>
            <path d="M5 8a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7A.5.5 0 0 1 5 8zm0-2.5a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1-.5-.5zm0 5a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1-.5-.5zm-1-5a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0zM4 8a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0zm0 2.5a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0z"/>
          </svg>
        </label>
      </div>
      <small id="results-message" class="left-aligned" style="display:none;"></small>
    </div>

    <br/><br/>

    <div id="results" class="case-study-tiles left-aligned">
      {% for study in collections.allCaseStudies %}
        <div class="case-study-tile-wrap{% if study.data.comingSoon %} case-study-tile-wrap--coming-soon{% endif %}">
          <a class="case-study-tile" {% if not study.data.comingSoon %}href="{{ study.url }}"{% endif %}>
            <img alt="Case study mockup" src="{{ study.data.thumbnail }}" />
            <span class="case-study-tile--title">{{ study.data.title }}</span>
            <p>{{ study.data.previewDesc | safe }}</p>
            <div class="case-study--tags">
              {% for skill in study.data.skills | limit(3) %}
                <div class="case-study--tag">{{ skill }}</div>
              {% endfor %}
            </div>
            {% if study.data.searchKeywords %}
              <div class="visibly-hidden">{{ study.data.searchKeywords }}</div>
            {% endif %}
          </a>
        </div>
      {% endfor %}
    </div>

    <div id="no-results">
      It seems I don't have any case studies matching that search term... yet!
    </div>

    {% include "partials/contact-callout.njk" %}
  </div>
</section>
